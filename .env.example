# Copy to .env and adjust. Every setting has a safe default.

# ---------- AI model (llama.cpp: GPU+CPU or CPU only) ----------
LLM_ENABLED=true
# --profile gpu -> http://llm-gpu:8080/v1   |   --profile cpu -> http://llm-cpu:8080/v1
LLM_BASE_URL=http://llm-gpu:8080/v1
LLM_MODEL=flowlens-llm
LLM_API_KEY=change-me-to-a-long-random-string
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_S=300
# Save every model request + answer to DATA_DIR/training/ as training data (see training/README.md).
# Keep false on a public instance unless users opted in.
TRAINING_LOG=false
# Model requests sent at once (match LLM_PARALLEL below)
LLM_CONCURRENCY=2
# Files the AI summarizes up front (most-used first). Lower = faster uploads.
MAX_FILE_SUMMARIES=40

# Model file (GGUF from Hugging Face), about 18.6 GB
LLM_GGUF_REPO=unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF:Q4_K_M
LLM_CTX_SIZE=32768
LLM_PARALLEL=2

# GPU only: experts of N of 48 layers stay in system RAM (lower = faster, more VRAM)
LLM_CPU_MOE=30
# Driver 580 -> server-cuda. With driver 590+ you can use server-cuda13.
LLAMA_IMAGE_TAG=server-cuda
LLM_PORT=8081
HF_TOKEN=

# ---------- Limits (protect your server) ----------
MAX_UPLOAD_MB=50
MAX_FILES=5000
# Single file mode (any language)
SINGLE_FILE_MAX_KB=300
MAX_CONCURRENT_JOBS=1
RATE_LIMIT_PER_HOUR=20
JOB_TTL_MINUTES=60

# ---------- Hosting ----------
WEB_PORT=8080
# Set true when running behind Cloudflare Tunnel / a reverse proxy.
TRUST_PROXY_HEADERS=false
CLOUDFLARE_TUNNEL_TOKEN=
# Only needed when the frontend is hosted on a different domain.
CORS_ORIGINS=["http://localhost:5173"]
